# Apple ID + app-specifiek wachtwoord (account.apple.com → Inloggen en beveiliging)
ICLOUD_USER=jij@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Toegangssleutel voor de planner en de API (min. 16 tekens):
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AUTH_KEY=
TIMEZONE=Europe/Brussels
# Wie de planner in een iframe mag tonen (Home Assistant)
FRAME_ANCESTORS=self http://homeassistant.local:8123
# auto = Secure-cookie enkel via https
COOKIE_SECURE=auto
# Map voor opgeslagen gegevens (routines)
DATA_DIR=/data
# Optioneel: Home Assistant-webhook bij een voltooide routine (lichtje, geluid…)
HA_WEBHOOK_URL=
# MOCK=1 → nepdata, geen iCloud nodig
MOCK=0
